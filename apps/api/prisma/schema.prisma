// ─────────────────────────────────────────────────────────────
// DigiSanté Mobile — schéma Prisma complet
// 49 modèles + 31 enums (cf. DocTech §5), dont la table d'audit immuable (§4).
// Cible : PostgreSQL 16 natif (dev local docker, prod VPS Infomaniak).
//
// Décisions (arbitrées) :
//   - Lang  : FR · EN · FON · YOR                       (source : DocTech)
//   - Role  : PATIENT · MEDECIN · PHARMACIE · LABORATOIRE · DIASPORA · ADMIN (FR)
//   - AuditLog (§4) : trail immuable append-only, hash SHA-256 chaîné
//     (triggers anti UPDATE/DELETE/TRUNCATE posés dans les migrations).
//
// Conformité APDP (§4) : champs santé chiffrés (encryptedData/encryptedUrl),
// accès DMP par partage consenti (shareToken/shareExpiry), audit immuable.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════
//  ENUMS (28)
// ══════════════════════════════════════════════════════════════

enum Role {
  PATIENT
  MEDECIN
  PHARMACIE
  LABORATOIRE
  DIASPORA
  ASC
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  PENDING_KYC
}

enum Lang {
  FR
  EN
  FON
  YOR
}

enum AppointmentType {
  PHYSICAL
  TELECONSULTATION
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ConsultationMode {
  VIDEO
  AUDIO
  CHAT
}

enum ConsultationStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
}

enum MedicalRecordType {
  VITAL_SIGNS
  DIAGNOSIS
  VACCINATION
  ALLERGY
  LAB_RESULT
  PRESCRIPTION
  IMAGING
  SURGERY
  CHRONIC_DISEASE
  OTHER
}

enum PrescriptionStatus {
  ACTIVE
  PARTIALLY_DISPENSED
  FULLY_DISPENSED
  EXPIRED
  CANCELLED
}

enum PrescriptionItemStatus {
  PENDING
  DISPENSED
  PARTIALLY_DISPENSED
  UNAVAILABLE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  MTN_MOMO
  MOOV_MONEY
  WAVE
  ORANGE_MONEY
  VISA_MC
  WALLET
}

enum PaymentType {
  CONSULTATION
  SUBSCRIPTION
  WALLET_TOPUP
  LAB_TEST
  PHARMACY
}

enum NotificationType {
  APPOINTMENT_REMINDER
  CONSULTATION_START
  PRESCRIPTION_READY
  LAB_RESULT
  SOS_ALERT
  PAYMENT_CONFIRMED
  SYSTEM
}

enum NotificationChannel {
  PUSH_FCM
  SMS_TWILIO
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum SosStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum KycDocumentType {
  NATIONAL_ID
  MEDICAL_DEGREE
  ORDER_LICENSE
  PRACTICE_LICENSE
  PROFESSIONAL_PHOTO
  MALPRACTICE_INSURANCE
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum LabOrderStatus {
  PENDING
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InsuranceCoverageStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum WalletTransactionType {
  TOPUP
  DEBIT
  REFUND
  // Entrant : restitution d'un paiement débité du portefeuille (distinct du
  // REFUND sortant qui annule une recharge FedaPay).
  REFUND_IN
  // Sortant : envoi d'argent à un proche (carnet Beneficiary).
  TRANSFER
  // Entrant : réception d'un envoi d'un proche. Distinct de TOPUP (recharge
  // FedaPay) pour que l'historique du destinataire dise d'où vient l'argent.
  TRANSFER_IN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  CLINIC
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ContentCategory {
  PREVENTION
  NUTRITION
  MATERNITY
  VACCINATION
  CHRONIC
  MENTAL_HEALTH
  EMERGENCY
  OTHER
}

// (enum AdminAction supprimée avec AdminAuditLog — les actions d'administration
// sont journalisées dans `AuditLog.action`, un String libre et extensible.)

enum ShareType {
  QR_CODE
  LINK
  TEMPORARY_ACCESS
}

// ══════════════════════════════════════════════════════════════
//  MODÈLES (26 + AuditLog)
// ══════════════════════════════════════════════════════════════

// 1 — User : compte (auth phone/OTP, JWT). Pivot de tous les espaces.
model User {
  mutationReceipts MutationReceipt[]
  id           String     @id @default(cuid())
  phone        String     @unique
  email        String?    @unique
  role         Role       @default(PATIENT)
  status       UserStatus @default(PENDING_VERIFICATION)
  lang         Lang       @default(FR)
  fcmToken     String?
  passwordHash String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile        Profile?
  doctor         Doctor?
  patient        Patient?
  pharmacy       Pharmacy?
  lab            Lab?
  communityWorker CommunityHealthWorker?
  wallet         Wallet?
  payments       Payment[]
  notifications  Notification[]
  kycSubmissions KycSubmission[]
  kycReviews       KycReview[]     @relation("KycReviewer")
  chatMessages     ChatMessage[]   @relation("ChatSender")
  consentsReceived Consent[]       @relation("ConsentGrantee")
  beneficiaries    Beneficiary[]
  adminProfile     AdminProfile?   @relation("AdminProfileUser")
  supportNotes     SupportNote[]   @relation("SupportNoteUser")
  healthCampaigns  HealthCampaign[] @relation("HealthCampaignAuthor")

  @@index([role])
  @@index([status])
  @@index([lang])
  @@map("users")
}

// Profil administrateur (RBAC back-office) — 1:1 avec un User rôle ADMIN.
// `scopes` = permissions effectives ; `preset` = raccourci d'attribution lisible.
// Un admin `suspendedAt` non nul est désactivé (toutes ses actions refusées).
model AdminProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  scopes      String[]  @default([])
  preset      String?
  suspendedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation("AdminProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// Diffusion / veille sanitaire (admin) — CLAUDE.md §1 (back-office).
// Une campagne rédigée en plusieurs langues (source de vérité FR), ciblée par
// rôle et/ou langue, puis DIFFUSÉE une fois : fan-out de Notification PENDING par
// destinataire dans SA langue (§4 SMS/notif toujours dans la langue). NON médical
// (message de santé publique) — jamais de contenu DMP. `translations` = JSON
// { FR:{title,body}, EN:{...}, FON?:{...}, YOR?:{...} } (repli FR à la diffusion).
model HealthCampaign {
  id            String         @id @default(cuid())
  category      String // ContentCategory (PREVENTION, VACCINATION, EMERGENCY…)
  translations  Json // { <Lang>: { title, body } } — FR obligatoire (source)
  audienceRole  Role? // null = tous les rôles
  audienceLang  Lang? // null = toutes les langues
  channel       NotificationChannel @default(IN_APP)
  status        CampaignStatus @default(DRAFT)
  audienceCount Int            @default(0)
  createdById   String
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdBy User @relation("HealthCampaignAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("health_campaigns")
}

enum CampaignStatus {
  DRAFT
  SENT
}

// Note interne de support sur un compte (back-office). `authorId` = admin auteur.
// §4 : aucune donnée médicale — note opérationnelle uniquement.
model SupportNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  user User @relation("SupportNoteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("support_notes")
}

// 2 — Profile : informations civiles (1:1 User).
model Profile {
  id               String    @id @default(cuid())
  userId           String    @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  emergencyContact String?
  avatarUrl        String?
  spokenLangs      Lang[]    @default([]) // langues parlées (🗣 fiche personne, CLAUDE.md §5)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// 3 — Doctor : praticien (espace PRO indigo). Abonnement PRO/CLINIC.
model Doctor {
  id                 String             @id @default(cuid())
  userId             String             @unique
  speciality         String
  licenseNumber      String             @unique
  verifiedAt         DateTime?
  slotDuration       Int                @default(30)
  consultFee         Decimal            @db.Decimal(12, 2)
  bio                String?
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments          Appointment[]
  prescriptions         Prescription[]
  labOrders             LabOrder[]
  labResultsInterpreted LabResult[]    @relation("LabResultInterpreter")
  referralsFrom         Referral[]     @relation("ReferralFrom")
  referralsTo           Referral[]     @relation("ReferralTo")
  chatThreads           ChatThread[]
  reviews               DoctorReview[]

  @@index([speciality])
  @@map("doctors")
}

// 4 — Patient : dossier patient (espace Patient vert).
model Patient {
  id              String   @id @default(cuid())
  userId          String   @unique
  bloodGroup      String?
  allergies       String[]
  chronicDiseases String[]
  insuranceNumber String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalRecords    MedicalRecord[]
  appointments      Appointment[]
  prescriptions     Prescription[]
  sosAlerts         Sos[]
  referrals         Referral[]
  labOrders         LabOrder[]
  patientInsurances PatientInsurance[]
  chatThreads        ChatThread[]
  consents           Consent[]
  medicationIntakes  MedicationIntake[]
  medicationReminders MedicationReminder[]
  reviews            DoctorReview[]
  vaccinationSubjects VaccinationSubject[]
  pregnancies         Pregnancy[]

  @@map("patients")
}

// 5 — Appointment : rendez-vous (physique ou téléconsultation).
model Appointment {
  id           String            @id @default(cuid())
  patientId    String
  doctorId     String
  type         AppointmentType
  status       AppointmentStatus @default(PENDING)
  scheduledAt    DateTime
  cancelReason   String?
  triage         Json?
  reminderSentAt DateTime? // rappel de RDV généré (idempotence du générateur)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultation Consultation?
  payment      Payment?

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

// 6 — Consultation : session de téléconsultation (Daily.co) ou suivi.
model Consultation {
  id            String             @id @default(cuid())
  appointmentId String             @unique
  mode          ConsultationMode
  status        ConsultationStatus @default(WAITING)
  dailyRoomName String?
  dailyRoomUrl  String?
  startedAt     DateTime?
  endedAt       DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]

  @@map("consultations")
}

// 7 — MedicalRecord : entrée du DMP. data chiffrée, partage consenti (§4).
model MedicalRecord {
  id            String            @id @default(cuid())
  patientId     String
  type          MedicalRecordType
  title         String
  // Identité authentifiée à la création, conservée même après suppression du compte.
  // Pas de FK vers User : une suppression ne doit pas effacer la preuve d'auteur.
  // Les entrées historiques non attribuables restent null, jamais « attribuées » au patient.
  authorId      String?
  authorRole    Role?
  data          Json?
  encryptedData String?
  shareToken    String?           @unique
  shareType     ShareType?
  shareExpiry   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documents      Document[]
  consentRecords ConsentRecord[]

  @@index([patientId])
  @@index([type])
  @@map("medical_records")
}

// 8 — Document : pièce jointe chiffrée d'une entrée DMP.
model Document {
  id              String   @id @default(cuid())
  medicalRecordId String
  filename        String
  mimeType        String
  size            Int
  encryptedUrl    String
  checksum        String
  createdAt       DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
  @@map("documents")
}

// 9 — Prescription : ordonnance (QR code, validité).
model Prescription {
  id             String             @id @default(cuid())
  doctorId       String
  patientId      String
  consultationId String?
  status         PrescriptionStatus @default(ACTIVE)
  qrCode         String?            @unique
  validUntil     DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  doctor        Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation  Consultation?      @relation(fields: [consultationId], references: [id])
  items         PrescriptionItem[]
  dispensations Dispensation[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("prescriptions")
}

// 10 — PrescriptionItem : ligne de médicament d'une ordonnance.
model PrescriptionItem {
  id             String                 @id @default(cuid())
  prescriptionId String
  medicationName String
  dosage         String
  frequency      String
  duration       String
  status         PrescriptionItemStatus @default(PENDING)
  createdAt      DateTime               @default(now())

  prescription Prescription         @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  intakes      MedicationIntake[]
  reminders    MedicationReminder[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

// 11 — Payment : paiement FedaPay (Mobile Money / wallet diaspora).
model Payment {
  id            String        @id @default(cuid())
  userId        String
  appointmentId String?       @unique
  type          PaymentType
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("XOF")
  status        PaymentStatus @default(PENDING)
  fedapayId     String?       @unique
  receiptUrl    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// 12 — Notification : multicanal (FCM / SMS Twilio / email / in-app).
model Notification {
  id          String              @id @default(cuid())
  recipientId String
  type        NotificationType
  channel     NotificationChannel
  title       String
  body        String
  status      NotificationStatus  @default(PENDING)
  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([status])
  @@map("notifications")
}

// 13 — Sos : alerte urgence géolocalisée.
model Sos {
  id              String    @id @default(cuid())
  patientId       String
  latitude        Float
  longitude       Float
  status          SosStatus @default(ACTIVE)
  resolvedAt      DateTime?
  contactNotified Boolean   @default(false)
  createdAt       DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("sos_alerts")
}

// 14 — KycSubmission : dossier de vérification professionnelle.
model KycSubmission {
  id              String    @id @default(cuid())
  userId          String
  status          KycStatus @default(NOT_SUBMITTED)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  labIdentity     Json? // Identité administrative figée à la soumission (L2).
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents KycDocument[]
  reviews   KycReview[]

  @@index([userId])
  @@index([status])
  @@map("kyc_submissions")
}

// 15 — KycDocument : pièce justificative d'un dossier KYC.
model KycDocument {
  id           String          @id @default(cuid())
  submissionId String
  type         KycDocumentType
  fileUrl      String // identifiant de stockage chiffré (lib/filestore) — PAS une URL publique (§4)
  mimeType     String?
  fileName     String?
  verified     Boolean         @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime        @default(now())

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("kyc_documents")
}

// 16 — KycReview : décision de revue KYC (par un admin/reviewer).
model KycReview {
  id           String    @id @default(cuid())
  submissionId String
  reviewerId   String
  decision     KycStatus
  notes        String?
  checklist    Json?
  createdAt    DateTime  @default(now())

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User          @relation("KycReviewer", fields: [reviewerId], references: [id])

  @@index([submissionId])
  @@map("kyc_reviews")
}

// 17 — Referral : orientation patient d'un médecin vers un autre.
model Referral {
  id           String         @id @default(cuid())
  fromDoctorId String
  toDoctorId   String
  patientId    String
  reason       String
  status       ReferralStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fromDoctor Doctor  @relation("ReferralFrom", fields: [fromDoctorId], references: [id])
  toDoctor   Doctor  @relation("ReferralTo", fields: [toDoctorId], references: [id])
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("referrals")
}

// 18 — LabOrder : demande d'analyse de laboratoire.
model LabOrder {
  id             String         @id @default(cuid())
  prescribedById String
  patientId      String
  labId          String?
  testType       String
  status         LabOrderStatus @default(PENDING)
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  prescribedBy Doctor     @relation(fields: [prescribedById], references: [id])
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lab          Lab?       @relation(fields: [labId], references: [id])
  result       LabResult?

  @@index([patientId])
  @@index([labId])
  @@index([status])
  @@map("lab_orders")
}

// 19 — Lab : laboratoire d'analyses (annuaire géolocalisé).
// userId optionnel : un labo d'annuaire peut exister sans compte rattaché.
model Lab {
  id              String   @id @default(cuid())
  userId          String?  @unique
  name            String
  address         String
  phone           String
  servicesOffered String[]
  licenseNumber   String?
  verifiedAt      DateTime? // NULL pour les comptes historiques ; revue L2 requise.
  geolat          Float?
  geolong         Float?
  createdAt       DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labOrders LabOrder[]

  @@map("labs")
}

// 19bis — Pharmacy : officine (annuaire géolocalisé), rattachée à un compte.
model Pharmacy {
  id              String   @id @default(cuid())
  userId          String   @unique
  name            String
  address         String
  phone           String
  licenseNumber   String?
  geolat          Float?
  geolong         Float?
  servicesOffered String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispensations Dispensation[]
  stocks        PharmacyStock[]

  @@map("pharmacies")
}

// 21bis — Dispensation : trace d'une délivrance par une pharmacie (journal local,
// historique privacy-safe). La pharmacie ne voit que ses propres délivrances.
model Dispensation {
  id             String             @id @default(cuid())
  prescriptionId String
  pharmacyId     String
  status         PrescriptionStatus
  lines          Json // [{ medicationName, status }]
  dispensedAt    DateTime           @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, dispensedAt])
  @@map("dispensations")
}

// 20 — LabResult : résultat d'analyse (interprété par un médecin).
model LabResult {
  id              String    @id @default(cuid())
  labOrderId      String    @unique
  values          Json
  reportUrl       String?
  interpretation  String?
  interpretedAt   DateTime?
  interpretedById String?
  createdAt       DateTime  @default(now())

  labOrder      LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  interpretedBy Doctor?  @relation("LabResultInterpreter", fields: [interpretedById], references: [id])

  @@map("lab_results")
}

// 21 — Insurance : organisme d'assurance santé.
model Insurance {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  apiEndpoint   String?
  coverageTypes String[]
  createdAt     DateTime @default(now())

  patientInsurances PatientInsurance[]

  @@map("insurances")
}

// 22 — PatientInsurance : couverture d'un patient (lien N:N enrichi).
model PatientInsurance {
  id           String                  @id @default(cuid())
  patientId    String
  insuranceId  String
  memberNumber String
  status       InsuranceCoverageStatus @default(ACTIVE)
  expiresAt    DateTime?
  coverageData Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insurance Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)

  @@unique([patientId, insuranceId])
  @@map("patient_insurances")
}

// 23 — Wallet : portefeuille (solde, recharges diaspora).
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("XOF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

// 24 — WalletTransaction : mouvement de portefeuille.
model WalletTransaction {
  id          String                @id @default(cuid())
  walletId    String
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(14, 2)
  reference   String?
  description String?
  createdAt   DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_transactions")
}

// 25 — HealthContent : contenu d'éducation à la santé (multilingue).
model HealthContent {
  id           String          @id @default(cuid())
  title        String
  body         String
  category     ContentCategory
  tags         String[]
  translations Json?
  isPublished  Boolean         @default(false)
  // Workflow éditorial : DRAFT → MEDICAL_REVIEW → TRANSLATION → PUBLISHED
  status       String          @default("DRAFT")
  reviewedById String? // professionnel vérifié ayant validé médicalement
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("health_contents")
}

// 26 — (supprimé, août 2026) AdminAuditLog était un SECOND journal d'audit,
// jamais écrit par l'application et dépourvu de chaîne de hachage. Le plan du
// back-office (docs/ADMIN_Backoffice_Proposal.md §9-2) laissait la question du
// « journal unique » ouverte ; les lots A→H ont tranché de fait en écrivant
// TOUTES les actions d'administration dans `AuditLog`. Décision actée ici :
// registre d'audit UNIQUE = `AuditLog` (append-only, SHA-256 chaîné).
// Migration `..._drop_admin_audit_log`.

// (+1) AuditLog — trail immuable transverse (§4) : DMP_ACCESS, KYC_*, PAYMENT_*,
// AUTH_FAIL, DATA_EXPORT, LAB_CRITICAL, USER_SUSPEND… Hash SHA-256 chaîné.
// Triggers anti UPDATE/DELETE posés dans la migration (append-only).
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  targetId  String?
  ip        String?
  meta      Json?
  prevHash  String?
  hash      String   @unique
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// (+2) ChatThread — fil de messagerie patient ↔ médecin (D-10, bascule téléconsult).
// Un seul fil par couple (patient, médecin). Le contenu des messages est chiffré
// au repos (§4 : potentiellement des données de santé).
model ChatThread {
  id            String    @id @default(cuid())
  patientId     String
  doctorId      String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
  @@map("chat_threads")
}

// (+3) ChatMessage — message d'un fil. Corps chiffré (encryptedBody) en prod,
// clair (body) en dev sans clé. sender = User (patient ou médecin).
model ChatMessage {
  id            String    @id @default(cuid())
  threadId      String
  senderId      String
  body          String?
  encryptedBody String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
  @@map("chat_messages")
}

// (+4) Consent — consentement DMP par SOIGNANT (§4). Lie un patient à un soignant
// bénéficiaire (grantee), avec expiration. Réclamé à la présentation d'un token de
// partage ; la révocation est persistante (un soignant révoqué ne peut pas
// re-réclamer via l'ancien token). Un seul consentement par couple (patient, soignant).
model Consent {
  id         String    @id @default(cuid())
  patientId  String
  granteeId  String // User.id du soignant bénéficiaire
  scope      String    @default("DMP")
  grantedVia String? // origine du consentement (ex. token de partage)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  patient Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  grantee User            @relation("ConsentGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  records ConsentRecord[]

  @@unique([patientId, granteeId])
  @@index([patientId])
  @@index([granteeId])
  @@map("consents")
}

// Portée PAR-ENTRÉE d'un consentement (§4 minimisation) : lie un Consent aux
// SEULES entrées de DMP effectivement partagées avec le soignant. Un soignant ne
// lit donc que ces entrées, pas tout le dossier. Ajouté à la réclamation du token.
model ConsentRecord {
  id        String   @id @default(cuid())
  consentId String
  recordId  String
  createdAt DateTime @default(now())
  // Source d'autorisation par entrée. null = historique non reconstructible, accès refusé.
  expiresAt DateTime?

  consent Consent       @relation(fields: [consentId], references: [id], onDelete: Cascade)
  record  MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([consentId, recordId])
  @@index([recordId])
  @@map("consent_records")
}

enum IntegrationProvider {
  FEDAPAY
  TWILIO
  DAILY
  FIREBASE
  RESEND
}

// Configuration d'une intégration tierce gérée depuis l'admin (super admin, §3.6).
// Les secrets sont CHIFFRÉS au repos (`secretsEnc`, AES-256-GCM) — JAMAIS en clair,
// jamais renvoyés au client (affichage masqué). `.env` reste le fallback tant
// qu'aucune ligne n'existe pour le provider. Les secrets d'INFRA n'y figurent JAMAIS.
model IntegrationConfig {
  id          String              @id @default(cuid())
  provider    IntegrationProvider @unique
  enabled     Boolean             @default(true)
  secretsEnc  String // blob chiffré d'un JSON { clé: valeur } — opaque, jamais exposé
  meta        Json? // non-secret : webhookUrl, fromNumber, domain… (affichable)
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  updatedById String? // admin auteur de la dernière écriture (audit)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("integration_configs")
}

// (+5) MedicationIntake — journal d'observance : une prise déclarée par le patient
// (« j'ai pris »). Permet le suivi (streak, % d'observance) des traitements
// chroniques. Reliée au PrescriptionItem si la prise vient d'une ordonnance.
model MedicationIntake {
  id             String   @id @default(cuid())
  patientId      String
  itemId         String? // PrescriptionItem (optionnel : prise hors ordonnance possible)
  medicationName String
  takenAt        DateTime @default(now())
  createdAt      DateTime @default(now())

  patient Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  item    PrescriptionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([takenAt])
  @@map("medication_intakes")
}

// (+6) MedicationReminder — rappel horaire RÉCURRENT d'un traitement (ex. 08:00).
// Un générateur (cron) matérialise les rappels dus du jour en Notification (PENDING)
// que le dispatch envoie. `lastGeneratedOn` assure l'idempotence (1 fois/jour).
model MedicationReminder {
  id              String    @id @default(cuid())
  patientId       String
  itemId          String? // PrescriptionItem (optionnel)
  medicationName  String
  time            String // "HH:mm" (heure locale du serveur)
  lastGeneratedOn DateTime?
  createdAt       DateTime  @default(now())

  patient Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  item    PrescriptionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("medication_reminders")
}

// (+7) DoctorReview — avis/note d'un patient sur un médecin (1 par couple).
// Éligibilité : un RDV terminé entre le patient et le médecin (anti-faux avis).
model DoctorReview {
  id        String   @id @default(cuid())
  doctorId  String
  patientId String
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, patientId])
  @@index([doctorId])
  @@map("doctor_reviews")
}

// (+8) Beneficiary — proche au Bénin géré par un membre de la DIASPORA.
// Carnet de proches (contact + langues parlées) qui sert de socle aux parcours
// diaspora (rappels, paiement de soins pour un proche). ⚠️ Modèle au-dessus de la
// logique de paiement GELÉE (§5) : aucune écriture ici ne touche FedaPay/wallet.
model Beneficiary {
  id              String   @id @default(cuid())
  ownerId         String // User.id du membre de la diaspora
  name            String
  relationship    String? // ex. « Mère », « Frère »
  phone           String?
  languagesSpoken String[] @default([])
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("beneficiaries")
}

// (+9) Vaccination PEV — carnet de vaccination du patient ET de ses proches
// (enfants). Le calendrier PEV Bénin (`@digisante/shared` PEV_SCHEDULE) génère
// les échéances à partir de la date de naissance. Rappels multilingues (§4) via
// le générateur cron (Notification PENDING), idempotents par jour (lastNotifiedOn).
// Cloisonnement §4 : chaque patient ne voit que SES sujets ; l'admin n'accède
// qu'à des agrégats anonymisés (couverture vaccinale), jamais au nominatif.
enum VaccinationStatus {
  SCHEDULED
  DONE
}

model VaccinationSubject {
  id        String   @id @default(cuid())
  patientId String
  name      String
  birthDate DateTime
  isSelf    Boolean  @default(false)
  createdAt DateTime @default(now())

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vaccinations Vaccination[]

  @@index([patientId])
  @@map("vaccination_subjects")
}

model Vaccination {
  id             String            @id @default(cuid())
  subjectId      String
  vaccineCode    String // code du calendrier PEV (BCG, PENTA1, VAR1…)
  doseLabel      String // ex. « 1 », « 0 », « rappel »
  dueDate        DateTime
  administeredAt DateTime?
  status         VaccinationStatus @default(SCHEDULED)
  lastNotifiedOn DateTime? // idempotence des rappels (au jour)
  createdAt      DateTime          @default(now())

  subject VaccinationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([status, dueDate])
  @@map("vaccinations")
}

// (+10) Santé maternelle — suivi de grossesse + consultations prénatales (CPN).
// À partir de la date des dernières règles (LMP), on calcule le terme (LMP+280 j)
// et on génère le calendrier CPN (8 contacts OMS 2016). Rappels multilingues (§4)
// via le générateur cron (Notification PENDING), idempotents par jour. Une seule
// grossesse ACTIVE (endedAt null) à la fois par patiente. Cloisonnement §4.
// ⚠️ Calendrier CPN à faire valider par un professionnel de santé.
model Pregnancy {
  id        String    @id @default(cuid())
  patientId String
  lmpDate   DateTime // date des dernières règles
  dueDate   DateTime // terme prévu (LMP + 280 j)
  endedAt   DateTime? // grossesse close (accouchement / fin de suivi)
  createdAt DateTime  @default(now())

  patient Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visits  AntenatalVisit[]

  @@index([patientId])
  @@map("pregnancies")
}

model AntenatalVisit {
  id             String    @id @default(cuid())
  pregnancyId    String
  contactNumber  Int // n° du contact CPN (1..8)
  dueDate        DateTime
  doneAt         DateTime?
  lastNotifiedOn DateTime? // idempotence des rappels (au jour)
  createdAt      DateTime  @default(now())

  pregnancy Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)

  @@index([pregnancyId])
  @@index([doneAt, dueDate])
  @@map("antenatal_visits")
}

// (+11) Disponibilité des médicaments en pharmacie — « médicament près de moi ».
// Chaque pharmacie déclare les médicaments qu'elle a en stock (statut + prix
// indicatif) ; le patient cherche un médicament et voit les pharmacies qui l'ont,
// triées par distance (si géolocalisation). Évite les trajets inutiles en zone
// reculée. NON médical (inventaire) — pas de DMP, §4 : une pharmacie ne gère QUE
// son propre stock ; la recherche patient est publique (statut, adresse, tél).
enum StockStatus {
  IN_STOCK
  LOW
  OUT
}

model PharmacyStock {
  id             String      @id @default(cuid())
  pharmacyId     String
  medicationName String // normalisé (minuscules, sans accents) pour la recherche
  displayName    String // libellé affiché
  status         StockStatus @default(IN_STOCK)
  price          Int? // prix indicatif en XOF (optionnel)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, medicationName])
  @@index([medicationName, status])
  @@map("pharmacy_stocks")
}

// (+12) Agent de Santé Communautaire (ASC / relais). Profil de rôle + carnet de
// terrain. Modèle A « relais aveugle » (docs/PLAN_ASC.md) : l'ASC gère SON roster
// (habitants qu'il suit) et un journal d'observations OPÉRATIONNEL (constantes,
// triage) — ce N'EST PAS un DMP patient (§4). Cloisonnement strict par `ascId` :
// un ASC ne voit/modifie QUE ses bénéficiaires. Le signalement partage la fiche
// avec un médecin choisi (Notification), jamais un accès DMP.
model CommunityHealthWorker {
  id        String   @id @default(cuid())
  userId    String   @unique
  zone      String // zone / village de rattachement
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiaries AscBeneficiary[]

  @@map("community_health_workers")
}

model AscBeneficiary {
  id        String    @id @default(cuid())
  ascId     String
  name      String
  phone     String?
  village   String?
  birthDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  asc          CommunityHealthWorker @relation(fields: [ascId], references: [id], onDelete: Cascade)
  observations AscObservation[]

  @@index([ascId])
  @@map("asc_beneficiaries")
}

model AscObservation {
  id            String   @id @default(cuid())
  beneficiaryId String
  systolic      Int?
  diastolic     Int?
  pulse         Int?
  temperature   Float?
  weight        Float?
  triageOutcome String? // EMERGENCY / CONSULT / HOME (résultat du triage embarqué)
  note          String?
  createdAt     DateTime @default(now())

  beneficiary AscBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@index([beneficiaryId])
  @@map("asc_observations")
}

// L3 : reçu durable écrit dans la transaction métier ; aucun corps en clair.
model MutationReceipt {
  id                String   @id @default(cuid())
  userId            String
  method            String   @db.VarChar(8)
  route             String   @db.VarChar(255)
  key               String   @db.VarChar(80)
  requestHash       String   @db.VarChar(64)
  responseStatus    Int
  encryptedResponse String
  resourceId        String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, method, route, key])
  @@index([expiresAt])
  @@map("mutation_receipts")
}
