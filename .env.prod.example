# ─────────────────────────────────────────────────────────────
# DigiSanté Mobile — PRODUCTION sur le VPS IONOS partagé (modèle, NOMS seulement)
# Hôte srv1.immipro.app (cohabite avec ImmiPro, BeninLink, Grafana) · DIGISANTE_ENV=production
# Domaines digisantemobile.app (+ www → redirection) · web 3200 / api 3201 · PostgreSQL 18 natif :5432
# base/rôle digisante · Valkey natif :6379 index 6 (JAMAIS un autre index, JAMAIS FLUSH*)
#
# AUCUNE valeur secrète ici : chaque secret vient du COFFRE et est saisi SUR L'HÔTE, dans
#   /var/www/digisante/apps/api/.env           (0600, digisante) — variables API
#   /var/www/digisante/apps/web/.env.production (0600, digisante) — NEXT_PUBLIC_*
# Les champs secrets sont VIDES exprès : l'API refuse de démarrer tant qu'ils ne sont pas
# renseignés (env.ts fail-safe) — un modèle copié tel quel ne tourne jamais avec un secret connu.
# Clés DISTINCTES de la préproduction. Mêmes clés que .env.example (test de parité
# scripts/infra/environments.test.mjs). Chargement : par l'API elle-même (apps/api/src/lib/env-file.ts,
# analyseur de --env-file), jamais `source`.
# Ouverture production : PV GO/NO-GO requis (L9 humain, L10 recettes, L11) — ce modèle n'autorise rien.
# ─────────────────────────────────────────────────────────────

# ── Base de données : rôle et base créés par provision-ionos.sh (mot de passe = coffre) ──
# Forme : postgresql://digisante:<PG_APP_PASSWORD URL-encodé>@127.0.0.1:5432/digisante?schema=public
# (connexion TCP locale : pg_hba doit autoriser 127.0.0.1/::1 en scram-sha-256 pour ce rôle).
DATABASE_URL=""

# ── Valkey (compatible Redis) : index 6 réservé à la production (marqueur digisante:owner) ──
# Forme : redis://:<mot de passe Valkey URL-encodé>@127.0.0.1:6379/6
#   (avec ACL : redis://<utilisateur>:<mot de passe>@127.0.0.1:6379/6). L'index /6 est OBLIGATOIRE.
REDIS_URL=""

# ── API (sans effet : PM2 impose 3201 et 127.0.0.1 via ecosystem.config.cjs) ──
API_PORT=3201
API_HOST=127.0.0.1
NODE_ENV=production
# Coffre : openssl rand -base64 48 (≥ 32 caractères), propre à la production.
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="https://digisantemobile.app"

# ── Chiffrement des données de santé (§4) — coffre, ≥ 32 caractères, copie de secours hors VPS ──
HEALTH_ENCRYPTION_KEY=""
# Magasin des pièces KYC/DMP chiffrées : chemin ABSOLU hors checkout, 0700, propriété de
# digisante (créé par provision-ionos.sh) ; lu comme donnée par la sauvegarde (B4).
KYC_STORAGE_DIR="/var/lib/digisante-files"

# ── Jeton des tâches internes (crons) — coffre, ≥ 32 caractères (openssl rand -hex 32) ──
# Recopié par provision-ionos.sh dans /etc/digisante/reconcile.token (root 0400).
RECONCILE_TOKEN=""

# ── Web (apps/web/.env.production, figé AU BUILD) ──
# Vide = appels relatifs, même origine (Nginx sert web + API sous le même domaine).
NEXT_PUBLIC_API_URL=""
# Numéro SOS affiché (format ARCEP 2024, 10 chiffres « 01 ») — décision du porteur avant GO.
NEXT_PUBLIC_SOS_NUMBER=""
# Firebase Web : configuration PUBLIQUE du projet de production (vide = push web désactivé).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ── Fournisseurs : configurés en BASE chiffrée via /admin/integrations (SUPER_ADMIN), qui
# PRIME sur ces variables ; fallback .env seulement. FedaPay = §5 : bascule live séparée,
# après recette sandbox (S1–S10), quatre yeux ; secret webhook roté AVEC la clé. ──
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Numéro de secours public prévenu lors d'un SOS — destination validée par le porteur.
SOS_PUBLIC_NUMBER=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
DAILY_API_KEY=""
DAILY_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ═════════════════════════════════════════════════════════════
# HORS .env DE L'APPLICATION — noms pour l'opérateur, jamais de valeur ici
# ═════════════════════════════════════════════════════════════
# GitHub Secrets du job `deploy` de ci.yml (Settings → Secrets, jamais sur l'hôte).
# Désignés « PROD_VPS_* » dans les consignes d'exploitation ; NOMS EXACTS lus par ci.yml :
#   VPS_HOST         hôte IONOS partagé
#   VPS_USER=digisante
#   VPS_SSH_KEY      clé privée de déploiement PROPRE à la production
#   VPS_FINGERPRINT  empreinte SHA256 de la clé d'hôte, vérifiée hors canal SSH
#   VPS_SSH_PORT     optionnel (22 par défaut)
# GitHub Variables : DEPLOY_ENABLED et DEPLOY_MAINTENANCE_READY restent false hors fenêtre autorisée.
#
# Environnement de provision-ionos.sh (coffre → variables de la session sudo, jamais écrites) :
#   PG_APP_PASSWORD     mot de passe du rôle digisante (24 à 256 caractères ASCII imprimables, sans espace —
#                       ex. openssl rand -hex 24 ; même valeur que DATABASE_URL ; seul un vérificateur SCRAM part au serveur)
#   VALKEY_PASSWORD     mot de passe Valkey de l'hôte (jamais affiché ; transmis par REDISCLI_AUTH) — sans ACL, il ouvre
#                       TOUS les index de l'hôte (ImmiPro/BeninLink compris) : README, résiduel 2
#   VALKEY_USERNAME     optionnel (ACL Valkey)
#   LETSENCRYPT_EMAIL   contact Let's Encrypt
#   DEPLOY_SSH_PUBKEY   clé PUBLIQUE de déploiement (optionnel)
#
# Smoke tests fournisseurs : JAMAIS en production (gardes L10 : base *_preprod obligatoire).
