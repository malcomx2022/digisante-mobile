# ─────────────────────────────────────────────────────────────
# Cron DigiSanté Mobile — PRÉPRODUCTION (L10, comptes synthétiques uniquement). Format /etc/cron.d (6ᵉ champ = utilisateur `root`).
# cf. CLAUDE.md §7 : pg_dump chiffré 02:00, réconciliation FedaPay 02:30.
#
# Hôte IONOS partagé (ImmiPro, BeninLink) : JAMAIS `crontab <fichier>`, qui REMPLACERAIT
# la crontab root des autres applications. Un fichier par environnement, installé depuis
# la copie INSTALLÉE root:root (jamais depuis APP_DIR, qu'une exécution de code dans l'API
# pourrait réécrire — bloquant B3) :
#   sudo install -o root -g root -m 0644 /usr/local/lib/digisante-preprod/infra/deploy/crontab.preproduction.example /etc/cron.d/digisante-preprod
# (nom sans point : cron ignore les fichiers de /etc/cron.d dont le nom en contient un ;
# fichier root:root non modifiable par autrui, sinon cron l'ignore aussi).
# DIGISANTE_ENV ci-dessous fixe, dans CHAQUE script, l'API visée (127.0.0.1:3101), les
# noms PM2 digisante-preprod-api/web, /etc/digisante-preprod, /var/lib/digisante-preprod,
# /var/backups/digisante-preprod, la base digisante_preprod et le checkout
# /var/www/digisante-preprod (profil `digisante_profile`).
# Tous les scripts lancés ci-dessous sont ceux de /usr/local/lib/digisante-preprod, installés
# par `DIGISANTE_ENV=preproduction install_root_scripts.sh <SHA>` depuis le miroir root ;
# aucun chemin sous /var/www. Journaux dans /var/log/digisante-preprod-cron (root:root 0750) :
# jamais dans le répertoire de l'utilisateur applicatif (lien symbolique).
#
# Fuseau : hôte PARTAGÉ (ImmiPro, BeninLink) — constater `timedatectl` (verify_deploy.sh attend
#   Africa/Porto-Novo, UTC+1) ; tout changement de fuseau est une décision du porteur (README, résiduel 3).
# ─────────────────────────────────────────────────────────────
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
DIGISANTE_ENV=preproduction

# Jeton de service interne : AUCUN secret dans ce fichier. `internal_job.sh` et
# `fedapay_reconcile.sh` lisent /etc/digisante-preprod/reconcile.token (root, 0600) — même
# valeur que RECONCILE_TOKEN du .env de l'API. Fichier absent ⇒ ÉCHEC journalisé.
# B3 : la requête (curl + réponse) part sous le compte sans droits digisante-preprod-jobs,
# jamais en root ; compte absent ⇒ ÉCHEC journalisé, aucune requête.
J=/usr/local/lib/digisante-preprod/infra/deploy/scripts/internal_job.sh

# Génération des rappels horaires de traitement dus → Notifications PENDING.
# Toutes les 5 minutes (idempotent par jour). À exécuter AVANT le dispatch.
*/5 * * * * root $J /api/v1/reminders/generate >> /var/log/digisante-preprod-cron/med_reminders.log 2>&1

# Génération des rappels de RDV (RDV confirmés dans les 24 h) → Notifications.
# Toutes les 15 minutes (idempotent par RDV via reminderSentAt).
*/15 * * * * root $J /api/v1/appointments/reminders/generate >> /var/log/digisante-preprod-cron/appt_reminders.log 2>&1

# Génération des rappels de VACCINATION (PEV) : doses non faites dues sous 7 j
# (retards inclus) → Notifications. Une fois par jour, idempotent (lastNotifiedOn).
# ⚠️ Ajouté en août 2026 : ce générateur existait depuis la v1.23 mais n'était PAS
# planifié — aucun rappel de vaccination n'aurait donc été émis en production.
30 6 * * * root $J /api/v1/vaccinations/reminders/generate >> /var/log/digisante-preprod-cron/vaccination_reminders.log 2>&1

# Génération des rappels de CPN (santé maternelle) → Notifications.
# Une fois par jour, idempotent (AntenatalVisit.lastNotifiedOn). Même oubli que
# ci-dessus : générateur livré en v1.25, jamais planifié.
40 6 * * * root $J /api/v1/maternity/reminders/generate >> /var/log/digisante-preprod-cron/maternity_reminders.log 2>&1

# Dispatch des notifications dues (rappels, SOS, labo…) — toutes les 2 minutes.
# Appelle l'endpoint interne protégé par le jeton de service (x-service-token).
*/2 * * * * root $J /api/v1/notifications/dispatch >> /var/log/digisante-preprod-cron/notify_dispatch.log 2>&1

# Sauvegarde PostgreSQL + magasin de fichiers, chiffrés — tous les jours à 01:30 (décalée
# de la production, 02:00, pour ne pas lancer deux pg_dump simultanés sur l'hôte partagé).
# Le magasin est lu dans le .env de l'API (KYC_STORAGE_DIR, comme l'API — B4), par
# défaut /var/www/digisante-preprod/apps/api/.env (API_ENV_FILE=/chemin/.env sinon).
# Il doit appartenir à l'utilisateur applicatif (digisante-preprod), en 0700 ; il est archivé
# sous l'identité de cet utilisateur, jamais lu par root à sa place (B3).
30 1 * * * root /usr/local/lib/digisante-preprod/infra/deploy/scripts/pg_dump_encrypted.sh >> /var/log/digisante-preprod-cron/pg_dump.log 2>&1

# Réconciliation FedaPay (module gelé) — tous les jours à 02:30
30 2 * * * root /usr/local/lib/digisante-preprod/infra/deploy/scripts/fedapay_reconcile.sh >> /var/log/digisante-preprod-cron/reconcile.log 2>&1

# Surveillance locale (aucun SaaS) : readiness, PM2, disque, fraîcheur des sauvegardes,
# tâches en échec, erreurs fournisseurs, backlog de notifications, webhooks rejetés, TLS.
# Alerte UNIQUEMENT sur changement d'état — destinataire : /etc/digisante-preprod/alert.conf.
*/5 * * * * root /usr/local/lib/digisante-preprod/infra/deploy/scripts/healthwatch.sh >> /var/log/digisante-preprod-cron/healthwatch.log 2>&1

# Renouvellement SSL Certbot — deux fois par jour (no-op si pas dû) ; décalé de la
# production (verrou certbot : deux renouvellements simultanés, un seul passe). --cert-name :
# SEUL le certificat DigiSanté ; jamais ceux des autres applications de l'hôte partagé.
45 3,15 * * * root certbot renew --quiet --cert-name preprod.digisantemobile.app --deploy-hook "systemctl reload nginx" >> /var/log/digisante-preprod-cron/certbot.log 2>&1

# L3 : reçus chiffrés conservés 14 jours, mutations acceptées au plus 7 jours.
10 3 * * * root $J /api/v1/sync/receipts/prune >> /var/log/digisante-preprod-cron/sync_receipts.log 2>&1
