# ─────────────────────────────────────────────────────────────
# Cron DigiSanté Mobile — à installer en root sur le VPS.
# cf. CLAUDE.md §7 : pg_dump chiffré 02:00, réconciliation FedaPay 02:30.
#
# Installation :
#   sudo crontab infra/deploy/crontab.example
# (ou copier ces lignes dans `sudo crontab -e`)
#
# Fuseau : régler l'horloge serveur sur Africa/Porto-Novo (UTC+1) :
#   sudo timedatectl set-timezone Africa/Porto-Novo
# ─────────────────────────────────────────────────────────────
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Jeton de service interne (= env RECONCILE_TOKEN de l'API) pour /dispatch.
# Renseigner la même valeur que dans le .env de l'API.
RECONCILE_TOKEN=changeme

# Génération des rappels horaires de traitement dus → Notifications PENDING.
# Toutes les 5 minutes (idempotent par jour). À exécuter AVANT le dispatch.
*/5 * * * * curl -fsS -X POST -H "x-service-token: ${RECONCILE_TOKEN}" http://127.0.0.1:3001/api/v1/reminders/generate >> /var/log/digisante/med_reminders.log 2>&1

# Génération des rappels de RDV (RDV confirmés dans les 24 h) → Notifications.
# Toutes les 15 minutes (idempotent par RDV via reminderSentAt).
*/15 * * * * curl -fsS -X POST -H "x-service-token: ${RECONCILE_TOKEN}" http://127.0.0.1:3001/api/v1/appointments/reminders/generate >> /var/log/digisante/appt_reminders.log 2>&1

# Dispatch des notifications dues (rappels, SOS, labo…) — toutes les 2 minutes.
# Appelle l'endpoint interne protégé par le jeton de service (x-service-token).
*/2 * * * * curl -fsS -X POST -H "x-service-token: ${RECONCILE_TOKEN}" http://127.0.0.1:3001/api/v1/notifications/dispatch >> /var/log/digisante/notify_dispatch.log 2>&1

# Sauvegarde PostgreSQL chiffrée — tous les jours à 02:00
0 2 * * * /var/www/digisante-mobile/infra/deploy/scripts/pg_dump_encrypted.sh >> /var/log/digisante/pg_dump.log 2>&1

# Réconciliation FedaPay (module gelé) — tous les jours à 02:30
30 2 * * * /var/www/digisante-mobile/infra/deploy/scripts/fedapay_reconcile.sh >> /var/log/digisante/reconcile.log 2>&1

# Renouvellement SSL Certbot — deux fois par jour (no-op si pas dû)
15 3,15 * * * certbot renew --quiet --deploy-hook "systemctl reload nginx"
