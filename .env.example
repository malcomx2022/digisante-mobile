# ─────────────────────────────────────────────────────────────
# DigiSanté Mobile — variables d'environnement (modèle)
# Copier vers apps/api/.env (et apps/web/.env.local) et remplir.
# En production : variables définies sur le VPS Infomaniak, jamais ici.
# Liste tenue à jour (CLAUDE.md §6). Les valeurs sensibles ne sont jamais commitées.
# ─────────────────────────────────────────────────────────────

# ── Base de données (DEV LOCAL : Postgres 16 via docker-compose) ──
DATABASE_URL="postgresql://digisante:devpassword@localhost:5432/digisante_dev?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── API ──
API_PORT=3001
API_HOST=0.0.0.0
# REQUIS (aucun défaut) : development | test | production. En prod, TOUJOURS 'production'.
NODE_ENV=development
# Hors 'test', ≥ 32 caractères obligatoires. La valeur ci-dessous est un placeholder
# de DEV — en PROD, remplacer par un secret aléatoire (openssl rand -base64 48).
JWT_SECRET="dev-only-jwt-secret-change-me-in-prod-0001"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="http://localhost:3000"

# ── Chiffrement des données de santé au repos (AES-256, §4) ──
# OBLIGATOIRE hors 'test' (≥ 32 caractères) — le chiffrement est TOUJOURS actif sur
# un vrai serveur. Placeholder de DEV ci-dessous ; en PROD : openssl rand -base64 48.
HEALTH_ENCRYPTION_KEY="dev-only-health-encryption-key-change-in-prod-0001"
# Répertoire des pièces KYC chiffrées sur le disque du VPS (défaut: storage/kyc — à inclure dans le backup)
KYC_STORAGE_DIR=""

# ── Jeton de service pour les tâches internes (cron réconciliation / dispatch) ──
RECONCILE_TOKEN=""

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Format ARCEP 2024 : 10 chiffres préfixe « 01 ». Exemple de démonstration —
# REMPLACER par le vrai numéro SOS en production.
NEXT_PUBLIC_SOS_NUMBER="+2290100000000"

# ── Firebase Web (push navigateur) — config PUBLIQUE (Console Firebase → Paramètres
# → Général → Vos applications Web). Laisser vide DÉSACTIVE le push web (no-op).
# VAPID : Console → Cloud Messaging → « Certificats push Web » → clé publique.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ── FedaPay (Mobile Money / cartes) ──
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# ── Twilio (SMS / OTP vocal) ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Numéro de secours public (SAMU/urgences) prévenu par SMS lors d'un SOS ──
SOS_PUBLIC_NUMBER=""

# ── Resend (emails transactionnels) ──
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DigiSanté <no-reply@digisante.bj>"

# ── Daily.co (téléconsultation WebRTC) ──
DAILY_API_KEY=""
DAILY_DOMAIN=""

# ── Firebase Cloud Messaging (push, API HTTP v1) ──
# Issus du JSON de compte de service Firebase (Console → Paramètres → Comptes de service).
# FIREBASE_PRIVATE_KEY : coller la clé en une ligne avec des "\n" littéraux (ils sont
# reconvertis en sauts de ligne au démarrage). Garder les guillemets.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
