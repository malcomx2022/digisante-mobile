# ─────────────────────────────────────────────────────────────
# DigiSanté Mobile — variables d'environnement (modèle)
# Copier vers apps/api/.env (et apps/web/.env.local) et remplir.
# En production : variables définies sur le VPS Infomaniak, jamais ici.
# ─────────────────────────────────────────────────────────────

# ── Base de données (DEV LOCAL : Postgres 16 via docker-compose) ──
DATABASE_URL="postgresql://digisante:devpassword@localhost:5432/digisante_dev?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── API ──
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="change-me-in-prod"
CORS_ORIGIN="http://localhost:3000"

# ── Web (Next.js) ──
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Intégrations (clés de TEST en local) ──
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
RESEND_API_KEY=""
DAILY_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
