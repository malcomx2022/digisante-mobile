{
  "name": "digisante-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "DigiSanté Mobile — PWA e-santé Bénin (programme NEXT IMPACT). Monorepo web (Next.js 14) + api (Fastify).",
  "author": "SEGLA E. Ulrich Gislain",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @digisante/shared build && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @digisante/web dev",
    "dev:api": "pnpm --filter @digisante/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docs:generate": "typedoc",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "release:check": "node scripts/release-check.mjs",
    "metrics": "node scripts/metrics/count.mjs",
    "metrics:check": "node scripts/metrics/count.mjs --check",
    "i18n:check": "node scripts/i18n/check-coverage.mjs",
    "i18n:export": "node scripts/i18n/check-coverage.mjs --export",
    "i18n:draft": "node scripts/i18n/translate-draft.mjs",
    "services:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "services:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @digisante/api prisma migrate dev",
    "db:generate": "pnpm --filter @digisante/api prisma generate",
    "db:seed": "pnpm --filter @digisante/api prisma db seed",
    "db:studio": "pnpm --filter @digisante/api prisma studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typedoc": "^0.28.20"
  }
}
