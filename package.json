{
  "name": "digisante-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "DigiSanté Mobile — PWA e-santé Bénin (programme NEXT IMPACT). Monorepo web (Next.js 14) + api (Fastify).",
  "author": "SEGLA E. Ulrich Gislain",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @digisante/shared build && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @digisante/web dev",
    "dev:api": "pnpm --filter @digisante/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docs:generate": "typedoc",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "release:check": "node scripts/release-check.mjs",
    "metrics": "node scripts/metrics/count.mjs",
    "metrics:check": "node scripts/metrics/count.mjs --check",
    "i18n:check": "node scripts/i18n/check-coverage.mjs",
    "i18n:export": "node scripts/i18n/check-coverage.mjs --export",
    "i18n:draft": "node scripts/i18n/translate-draft.mjs",
    "services:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "services:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @digisante/api prisma migrate dev",
    "db:generate": "pnpm --filter @digisante/api prisma generate",
    "db:seed": "pnpm --filter @digisante/api prisma db seed",
    "db:studio": "pnpm --filter @digisante/api prisma studio",
    "validation:prepare": "node scripts/validation/prepare-l9.mjs",
    "validation:check": "node scripts/validation/prepare-l9.mjs --check",
    "validation:gate": "node scripts/validation/check-l9-gate.mjs",
    "validation:campaign": "node scripts/validation/prepare-review-campaign.mjs",
    "validation:campaign:check": "node scripts/validation/prepare-review-campaign.mjs --check",
    "preprod:prepare": "node scripts/preproduction/prepare-l10.mjs",
    "preprod:check": "node scripts/preproduction/prepare-l10.mjs --check",
    "preprod:gate": "node scripts/preproduction/check-l10-gate.mjs",
    "preprod:qualify": "node scripts/preproduction/verify-candidate.mjs",
    "backup:check": "node scripts/preproduction/check-backup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typedoc": "^0.28.20"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "^3.1.9",
      "nanoid@3": "^3.3.18",
      "source-map-js@1": "^1.2.2",
      "@grpc/grpc-js@1": "^1.13.6",
      "protobufjs@7": "^7.6.5",
      "postcss@8": "^8.5.23",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@4": "^4.3.2",
      "markdown-it@14": "^14.3.3",
      "browserslist@4": "^4.28.7",
      "baseline-browser-mapping@2": "^2.11.0",
      "fast-copy@3": "^3.1.0",
      "postcss-selector-parser@6": "^6.1.5",
      "esbuild@0.28": "^0.28.2",
      "minimatch@9": "^11.0.1",
      "minimatch@10": "^11.0.1"
    }
  }
}
