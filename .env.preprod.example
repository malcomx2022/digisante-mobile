# ─────────────────────────────────────────────────────────────
# DigiSanté Mobile — PRÉPRODUCTION sur le VPS IONOS partagé (modèle, NOMS seulement)
# Hôte srv1.immipro.app (cohabite avec ImmiPro, BeninLink, Grafana) · DIGISANTE_ENV=preproduction
# Domaine preprod.digisantemobile.app · web 3100 / api 3101 · PostgreSQL 18 natif :5432
# base/rôle digisante_preprod · Valkey natif :6379 index 5 (JAMAIS un autre index, JAMAIS FLUSH*)
#
# AUCUNE valeur secrète ici : chaque secret vient du COFFRE et est saisi SUR L'HÔTE, dans
#   /var/www/digisante-preprod/apps/api/.env           (0600, digisante-preprod) — variables API
#   /var/www/digisante-preprod/apps/web/.env.production (0600, digisante-preprod) — NEXT_PUBLIC_*
# Les champs secrets sont VIDES exprès : l'API refuse de démarrer tant qu'ils ne sont pas
# renseignés (env.ts fail-safe) — un modèle copié tel quel ne tourne jamais avec un secret connu.
# Clés DISTINCTES de la production (jamais la clé de santé ni le JWT de prod en préprod).
# Mêmes clés que .env.example (test de parité scripts/infra/environments.test.mjs).
# Chargement : par l'API elle-même (apps/api/src/lib/env-file.ts, analyseur de --env-file),
# jamais `source` d'un shell.
# ─────────────────────────────────────────────────────────────

# ── Base de données : rôle et base créés par provision-ionos.sh (mot de passe = coffre) ──
# Forme : postgresql://digisante_preprod:<PG_APP_PASSWORD URL-encodé>@127.0.0.1:5432/digisante_preprod?schema=public
# (connexion TCP locale : pg_hba doit autoriser 127.0.0.1/::1 en scram-sha-256 pour ce rôle).
DATABASE_URL=""

# ── Valkey (compatible Redis) : index 5 réservé à la préproduction (marqueur digisante:owner) ──
# Forme : redis://:<mot de passe Valkey URL-encodé>@127.0.0.1:6379/5
#   (avec ACL : redis://<utilisateur>:<mot de passe>@127.0.0.1:6379/5). L'index /5 est OBLIGATOIRE.
REDIS_URL=""

# ── API (sans effet : PM2 impose 3101 et 127.0.0.1 via ecosystem.config.cjs) ──
API_PORT=3101
API_HOST=127.0.0.1
NODE_ENV=production
# Coffre : openssl rand -base64 48 (≥ 32 caractères), propre à la préproduction.
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGIN="https://preprod.digisantemobile.app"

# ── Chiffrement des données de santé (§4) — coffre, ≥ 32 caractères, JAMAIS celle de prod ──
HEALTH_ENCRYPTION_KEY=""
# Magasin des pièces KYC/DMP chiffrées : chemin ABSOLU hors checkout, 0700, propriété de
# digisante-preprod (créé par provision-ionos.sh) ; lu comme donnée par la sauvegarde (B4).
KYC_STORAGE_DIR="/var/lib/digisante-preprod-files"

# ── Jeton des tâches internes (crons) — coffre, ≥ 32 caractères (openssl rand -hex 32) ──
# Recopié par provision-ionos.sh dans /etc/digisante-preprod/reconcile.token (root 0400).
RECONCILE_TOKEN=""

# ── Web (apps/web/.env.production, figé AU BUILD) ──
# Vide = appels relatifs, même origine (Nginx sert web + API sous le même domaine).
NEXT_PUBLIC_API_URL=""
# Préproduction : aucun numéro d'urgence public réel (recette T11 seulement vers une destination autorisée).
NEXT_PUBLIC_SOS_NUMBER=""
# Firebase Web : configuration PUBLIQUE d'un projet de recette isolé (vide = push web désactivé).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ── Fournisseurs : configurés en BASE chiffrée via /admin/integrations (SUPER_ADMIN), qui
# PRIME sur ces variables ; fallback .env seulement. Préproduction = comptes de RECETTE. ──
# FedaPay : clé sk_sandbox_… UNIQUEMENT (toute clé live est refusée par les gardes L10).
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Jamais le SAMU ni un numéro public réel en préproduction.
SOS_PUBLIC_NUMBER=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
DAILY_API_KEY=""
DAILY_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ═════════════════════════════════════════════════════════════
# HORS .env DE L'APPLICATION — noms pour l'opérateur, jamais de valeur ici
# ═════════════════════════════════════════════════════════════
# GitHub Secrets du workflow preproduction.yml (Settings → Secrets, jamais sur l'hôte) :
#   PREPROD_VPS_HOST         hôte IONOS partagé
#   PREPROD_VPS_USER=digisante-preprod
#   PREPROD_VPS_SSH_KEY      clé privée de déploiement PROPRE à la préproduction
#   PREPROD_VPS_FINGERPRINT  empreinte SHA256 de la clé d'hôte, vérifiée hors canal SSH
#   PREPROD_VPS_SSH_PORT     optionnel (22 par défaut)
# GitHub Variable : PREPROD_DEPLOY_ENABLED reste absente/false hors fenêtre autorisée.
#
# Environnement de provision-ionos.sh (coffre → variables de la session sudo, jamais écrites) :
#   PG_APP_PASSWORD     mot de passe du rôle digisante_preprod (24 à 256 caractères ASCII imprimables, sans espace —
#                       ex. openssl rand -hex 24 ; même valeur que DATABASE_URL ; seul un vérificateur SCRAM part au serveur)
#   VALKEY_PASSWORD     mot de passe Valkey de l'hôte (jamais affiché ; transmis par REDISCLI_AUTH) — sans ACL, il ouvre
#                       TOUS les index de l'hôte (ImmiPro/BeninLink compris) : README, résiduel 2
#   VALKEY_USERNAME     optionnel (ACL Valkey)
#   LETSENCRYPT_EMAIL   contact Let's Encrypt
#   DEPLOY_SSH_PUBKEY   clé PUBLIQUE de déploiement (optionnel)
#
# Métadonnées smoke L10 (environnement de CHAQUE commande smoke, pas ce fichier ; aucun secret) :
#   SMOKE_ENVIRONMENT=preproduction
#   SMOKE_EXPECTED_SHA=<SHA complet qualifié, 40 hex>
#   SMOKE_DATABASE_NAME=digisante_preprod
#   SMOKE_REDIS_DB=5
#   un seul opt-in fournisseur (SMOKE_FEDAPAY=1 | SMOKE_TWILIO=1 | SMOKE_DAILY=1 | SMOKE_FCM=1 | SMOKE_RESEND=1 | SMOKE_FEDAPAY_S8=1, sonde S8)
#   destinataires privés injectés depuis le coffre : SMOKE_TWILIO_TO, SMOKE_FCM_TOKEN, EMAIL_RECIPIENT_TEST
